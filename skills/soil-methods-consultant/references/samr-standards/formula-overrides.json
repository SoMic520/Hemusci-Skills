    "samr-gb-t-31270-4-2025": {
      "14": [
        {"label": "（1）", "plain": "A_{tᵢ} = [mₛ^{ads}(tᵢ) / m₀] × 100", "latex": "A_{t_i}=\\frac{m_s^{\\mathrm{ads}}(t_i)}{m_0}\\times100", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第14页原分辨率页面"},
        {"label": "（2）", "plain": "m₀ = C₀V₀", "latex": "m_0=C_0V_0", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第14页原分辨率页面"},
        {"label": "（3）", "plain": "mₛ^{ads}(tᵢ) = m₀ − C_{aq}^{ads}(tᵢ)V₀", "latex": "m_s^{\\mathrm{ads}}(t_i)=m_0-C_{\\mathrm{aq}}^{\\mathrm{ads}}(t_i)V_0", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第14页原分辨率页面"},
        {"label": "（4）", "plain": "mₛ^{ads}(Δtₙ) = mₘ^{ads}(tₙ₋₁)[(V₀ − (n − 2)Vₐᴬ) / Vₐᴬ] − mₘ^{ads}(tₙ)[(V₀ − (n − 1)Vₐᴬ) / Vₐᴬ]", "latex": "m_s^{\\mathrm{ads}}(\\Delta t_n)=m_m^{\\mathrm{ads}}(t_{n-1})\\left[\\frac{V_0-(n-2)V_a^A}{V_a^A}\\right]-m_m^{\\mathrm{ads}}(t_n)\\left[\\frac{V_0-(n-1)V_a^A}{V_a^A}\\right]", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第14页原分辨率页面"},
        {"label": "（5）", "plain": "A_{Δtᵢ} = [mₛ^{ads}(Δtᵢ) / m₀] × 100", "latex": "A_{\\Delta t_i}=\\frac{m_s^{\\mathrm{ads}}(\\Delta t_i)}{m_0}\\times100", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第14页原分辨率页面"},
        {"label": "（6）", "plain": "A_{tᵢ} = [Σ_{j=Δtₙ}^{Δtₙ} mₛ^{ads}(j) / m₀] × 100", "latex": "A_{t_i}=\\frac{\\sum_{j=\\Delta t_n}^{\\Delta t_n}m_s^{\\mathrm{ads}}(j)}{m_0}\\times100", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第14页原分辨率页面；上下限按原文照录"},
        {"label": "（7）", "plain": "mₛ^{ads}(eq) = Σ_{Δtᵢ=1}^{n} mₛ^{ads}(Δtᵢ)", "latex": "m_s^{\\mathrm{ads}}(\\mathrm{eq})=\\sum_{\\Delta t_i=1}^{n}m_s^{\\mathrm{ads}}(\\Delta t_i)", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第14页原分辨率页面"}
      ],
      "15": [
        {"label": "（8）", "plain": "m_{aq}^{ads}(eq) = m₀ − Σ_{Δtᵢ=1}^{n} mₛ^{ads}(Δtᵢ)", "latex": "m_{\\mathrm{aq}}^{\\mathrm{ads}}(\\mathrm{eq})=m_0-\\sum_{\\Delta t_i=1}^{n}m_s^{\\mathrm{ads}}(\\Delta t_i)", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第15页原分辨率页面"},
        {"label": "（9）", "plain": "A_{eq} = [mₛ^{ads}(eq) / m₀] × 100", "latex": "A_{\\mathrm{eq}}=\\frac{m_s^{\\mathrm{ads}}(\\mathrm{eq})}{m_0}\\times100", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第15页原分辨率页面"},
        {"label": "（10）", "plain": "Cₛ^{ads}(eq) = mₛ^{ads}(eq) / m_{soil} = [C₀ − C_{aq}^{ads}(eq)]V₀ / m_{soil}", "latex": "C_s^{\\mathrm{ads}}(\\mathrm{eq})=\\frac{m_s^{\\mathrm{ads}}(\\mathrm{eq})}{m_{\\mathrm{soil}}}=\\frac{[C_0-C_{\\mathrm{aq}}^{\\mathrm{ads}}(\\mathrm{eq})]V_0}{m_{\\mathrm{soil}}}", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第15页原分辨率页面"},
        {"label": "（11）", "plain": "K_d = Cₛ^{ads}(eq) / C_{aq}^{ads}(eq)", "latex": "K_d=\\frac{C_s^{\\mathrm{ads}}(\\mathrm{eq})}{C_{\\mathrm{aq}}^{\\mathrm{ads}}(\\mathrm{eq})}", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第15页原分辨率页面"},
        {"label": "（12）", "plain": "Cₛ^{ads}(eq) = K_f^{ads}[C_{aq}^{ads}(eq)]^{1/n}", "latex": "C_s^{\\mathrm{ads}}(\\mathrm{eq})=K_f^{\\mathrm{ads}}[C_{\\mathrm{aq}}^{\\mathrm{ads}}(\\mathrm{eq})]^{1/n}", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第15页原分辨率页面"},
        {"label": "（13）", "plain": "lg Cₛ^{ads}(eq) = lg K_f^{ads} + (1/n)lg C_{aq}^{ads}(eq)", "latex": "\\lg C_s^{\\mathrm{ads}}(\\mathrm{eq})=\\lg K_f^{\\mathrm{ads}}+\\frac{1}{n}\\lg C_{\\mathrm{aq}}^{\\mathrm{ads}}(\\mathrm{eq})", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第15页原分辨率页面"},
        {"label": "（14）", "plain": "K_{oc} = K_d × (100 / OC)", "latex": "K_{\\mathrm{oc}}=K_d\\times\\frac{100}{OC}", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第15页原分辨率页面"}
      ],
      "16": [
        {"label": "（15）", "plain": "K_{foc} = K_f^{ads} × (100 / OC)", "latex": "K_{\\mathrm{foc}}=K_f^{\\mathrm{ads}}\\times\\frac{100}{OC}", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第16页原分辨率页面"},
        {"label": "（16）", "plain": "MB = [(V_{rec}C_{aq}^{ads}(eq) + m_E) / (V₀C₀)] × 100", "latex": "MB=\\frac{V_{\\mathrm{rec}}C_{\\mathrm{aq}}^{\\mathrm{ads}}(\\mathrm{eq})+m_E}{V_0C_0}\\times100", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第16页原分辨率页面"},
        {"label": "（17）", "plain": "D_{tᵢ} = [m_{aq}^{des}(tᵢ) / mₛ^{ads}(eq)] × 100", "latex": "D_{t_i}=\\frac{m_{\\mathrm{aq}}^{\\mathrm{des}}(t_i)}{m_s^{\\mathrm{ads}}(\\mathrm{eq})}\\times100", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第16页原分辨率页面"},
        {"label": "（18）", "plain": "m_{aq}ᴬ(tᵢ) = m_{aq}^{ads}(eq)[(V₀ − V_R) / V₀]", "latex": "m_{\\mathrm{aq}}^A(t_i)=m_{\\mathrm{aq}}^{\\mathrm{ads}}(\\mathrm{eq})\\left(\\frac{V_0-V_R}{V_0}\\right)", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第16页原分辨率页面"},
        {"label": "（19）", "plain": "m_{aq}^{des}(tᵢ) = mₘ^{des}(tᵢ)(V₀ / Vᵣⁱ) − m_{aq}ᴬ", "latex": "m_{\\mathrm{aq}}^{\\mathrm{des}}(t_i)=m_m^{\\mathrm{des}}(t_i)\\left(\\frac{V_0}{V_r^i}\\right)-m_{\\mathrm{aq}}^A", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第16页原分辨率页面"}
      ],
      "17": [
        {"label": "（20）", "plain": "m_{aq}^{des}(Δtᵢ) = m_{aq}^{des}(tᵢ) − Σ_{j=1}^{i−1}m_{aq}^{des}(j)", "latex": "m_{\\mathrm{aq}}^{\\mathrm{des}}(\\Delta t_i)=m_{\\mathrm{aq}}^{\\mathrm{des}}(t_i)-\\sum_{j=1}^{i-1}m_{\\mathrm{aq}}^{\\mathrm{des}}(j)", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第17页原分辨率页面"},
        {"label": "（21）", "plain": "D_{tᵢ} = [m_{aq}^{des}(tᵢ) / mₛ^{ads}(eq)] × 100", "latex": "D_{t_i}=\\frac{m_{\\mathrm{aq}}^{\\mathrm{des}}(t_i)}{m_s^{\\mathrm{ads}}(\\mathrm{eq})}\\times100", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第17页原分辨率页面"},
        {"label": "（22）", "plain": "D_{Δtᵢ} = [m_{aq}^{des}(Δtᵢ) / mₛ^{ads}(eq)] × 100", "latex": "D_{\\Delta t_i}=\\frac{m_{\\mathrm{aq}}^{\\mathrm{des}}(\\Delta t_i)}{m_s^{\\mathrm{ads}}(\\mathrm{eq})}\\times100", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第17页原分辨率页面"},
        {"label": "（23）", "plain": "V_T = V₀ − Σ_{i=1}^{n}Vₐᴰ(i)", "latex": "V_T=V_0-\\sum_{i=1}^{n}V_a^D(i)", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第17页原分辨率页面"},
        {"label": "（24）", "plain": "m_{aq}^{des}(tᵢ) = mₘ^{des}(tᵢ)(V_T / Vₐᴰ) − m_{aq}ᴬ[(V_T − (i − 1)Vₐᴰ) / V_T]", "latex": "m_{\\mathrm{aq}}^{\\mathrm{des}}(t_i)=m_m^{\\mathrm{des}}(t_i)\\left(\\frac{V_T}{V_a^D}\\right)-m_{\\mathrm{aq}}^A\\left[\\frac{V_T-(i-1)V_a^D}{V_T}\\right]", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第17页原分辨率页面"},
        {"label": "（25）", "plain": "D_{tᵢ} = [m_{aq}^{des}(tᵢ) / mₛ^{ads}(eq)] × 100", "latex": "D_{t_i}=\\frac{m_{\\mathrm{aq}}^{\\mathrm{des}}(t_i)}{m_s^{\\mathrm{ads}}(\\mathrm{eq})}\\times100", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第17页原分辨率页面"},
        {"label": "（26）", "plain": "m_{aq}^{des}(Δtₙ) = {mₘ^{des}(tₙ)(V_T / Vₐᴰ) − m_{aq}ᴬ[(V_T − (n − 1)Vₐᴰ) / V_T] − Σ_{i=1,n≠1}^{n−1}[(V_T − (n − i)Vₐᴰ) / V_T]m_{aq}^{des}(Δtᵢ)}", "latex": "m_{\\mathrm{aq}}^{\\mathrm{des}}(\\Delta t_n)=\\left\\{m_m^{\\mathrm{des}}(t_n)\\left(\\frac{V_T}{V_a^D}\\right)-m_{\\mathrm{aq}}^A\\left[\\frac{V_T-(n-1)V_a^D}{V_T}\\right]-\\sum_{i=1,n\\ne1}^{n-1}\\left[\\frac{V_T-(n-i)V_a^D}{V_T}\\right]m_{\\mathrm{aq}}^{\\mathrm{des}}(\\Delta t_i)\\right\\}", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第17页原分辨率页面"}
      ],
      "18": [
        {"label": "（27）", "plain": "mₛ^{des}(tₙ) = mₛ^{ads}(eq) − Σ_{i=1,n≠1}^{n−1}m_{aq}^{des}(Δtᵢ)", "latex": "m_s^{\\mathrm{des}}(t_n)=m_s^{\\mathrm{ads}}(\\mathrm{eq})-\\sum_{i=1,n\\ne1}^{n-1}m_{\\mathrm{aq}}^{\\mathrm{des}}(\\Delta t_i)", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第18页原分辨率页面"},
        {"label": "（28）", "plain": "D_{Δtᵢ} = [m_{aq}^{des}(Δtᵢ) / mₛ^{ads}(eq)] × 100", "latex": "D_{\\Delta t_i}=\\frac{m_{\\mathrm{aq}}^{\\mathrm{des}}(\\Delta t_i)}{m_s^{\\mathrm{ads}}(\\mathrm{eq})}\\times100", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第18页原分辨率页面"},
        {"label": "（29）", "plain": "D_{tᵢ} = [m_{aq}^{des}(tᵢ) / mₛ^{ads}(eq)] × 100", "latex": "D_{t_i}=\\frac{m_{\\mathrm{aq}}^{\\mathrm{des}}(t_i)}{m_s^{\\mathrm{ads}}(\\mathrm{eq})}\\times100", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第18页原分辨率页面"},
        {"label": "（30）", "plain": "m_{aq}ᴬ = {[V₀ − Σ_{i=1}^{n}Vₐᴬ(i) − V_R] / [V₀ − Σ_{i=1}^{n}Vₐᴬ(i)]} × m_{aq}^{ads}(eq)", "latex": "m_{\\mathrm{aq}}^A=\\left\\{\\frac{V_0-\\sum_{i=1}^{n}V_a^A(i)-V_R}{V_0-\\sum_{i=1}^{n}V_a^A(i)}\\right\\}\\times m_{\\mathrm{aq}}^{\\mathrm{ads}}(\\mathrm{eq})", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第18页原分辨率页面"},
        {"label": "（31）", "plain": "K_{des} = {[mₛ^{ads}(eq) − m_{aq}^{des}(eq)] / m_{aq}^{des}(eq)} × (V_T / m_{soil})", "latex": "K_{\\mathrm{des}}=\\frac{m_s^{\\mathrm{ads}}(\\mathrm{eq})-m_{\\mathrm{aq}}^{\\mathrm{des}}(\\mathrm{eq})}{m_{\\mathrm{aq}}^{\\mathrm{des}}(\\mathrm{eq})}\\times\\frac{V_T}{m_{\\mathrm{soil}}}", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第18页原分辨率页面"},
        {"label": "（32）", "plain": "Cₛ^{des}(eq) = [mₛ^{ads}(eq) − m_{aq}^{des}(eq)] / m_{soil}", "latex": "C_s^{\\mathrm{des}}(\\mathrm{eq})=\\frac{m_s^{\\mathrm{ads}}(\\mathrm{eq})-m_{\\mathrm{aq}}^{\\mathrm{des}}(\\mathrm{eq})}{m_{\\mathrm{soil}}}", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第18页原分辨率页面"},
        {"label": "（33）", "plain": "m_{aq}^{des}(eq) = mₘ^{des}(eq)(V₀ / Vᵣᶠ) − m_{aq}ᴬ", "latex": "m_{\\mathrm{aq}}^{\\mathrm{des}}(\\mathrm{eq})=m_m^{\\mathrm{des}}(\\mathrm{eq})\\times\\frac{V_0}{V_r^F}-m_{\\mathrm{aq}}^A", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第18页原分辨率页面；原式体积符号上标为F"}
      ],
      "19": [
        {"label": "（34）", "plain": "Cₛ^{des}(eq) = K_f^{des}[C_{aq}^{des}(eq)]^{1/n}", "latex": "C_s^{\\mathrm{des}}(\\mathrm{eq})=K_f^{\\mathrm{des}}[C_{\\mathrm{aq}}^{\\mathrm{des}}(\\mathrm{eq})]^{1/n}", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第19页原分辨率页面"},
        {"label": "（35）", "plain": "lg Cₛ^{des}(eq) = lg K_f^{des} + (1/n)lg C_{aq}^{des}(eq)", "latex": "\\lg C_s^{\\mathrm{des}}(\\mathrm{eq})=\\lg K_f^{\\mathrm{des}}+\\frac{1}{n}\\lg C_{\\mathrm{aq}}^{\\mathrm{des}}(\\mathrm{eq})", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第19页原分辨率页面"}
      ],
      "22": [
        {"label": "（B.1）", "plain": "V₀ / m_{soil} = [m₀ / mₛ^{ads}(eq) − 1]K_d", "latex": "\\frac{V_0}{m_{\\mathrm{soil}}}=\\left[\\frac{m_0}{m_s^{\\mathrm{ads}}(\\mathrm{eq})}-1\\right]K_d", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第22页原分辨率页面"},
        {"label": "（B.2）", "plain": "R = m_{soil} / V₀，A_{eq} / 100 = mₛ^{ads}(eq) / m₀", "latex": "R=\\frac{m_{\\mathrm{soil}}}{V_0},\\quad\\frac{A_{\\mathrm{eq}}}{100}=\\frac{m_s^{\\mathrm{ads}}(\\mathrm{eq})}{m_0}", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第22页原分辨率页面"},
        {"label": "（B.3）", "plain": "lg R = −lg K_d + lg{(A_{eq}/100) / [1 − (A_{eq}/100)]}", "latex": "\\lg R=-\\lg K_d+\\lg\\left(\\frac{A_{\\mathrm{eq}}/100}{1-A_{\\mathrm{eq}}/100}\\right)", "reviewStatus": "verified", "reviewMethod": "对照官方在线阅读器第22页原分辨率页面"}
