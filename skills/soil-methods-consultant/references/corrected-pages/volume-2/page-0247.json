  "blocks": [
    {"type": "heading", "number": "77.2.2.2", "title": "多固定水头", "level": 4},
    {
      "type": "calculation-guidance",
      "text": "两个或更多水头可同时求K_fs和α*，无需分类估α*。两水头用式(77.3)；多水头把q_i对H_i作线性最小二乘，斜率乘T得K_fs，再由截距求α*。两个点时联立式与直线回归严格等价。"
    },
    {
      "type": "source-fidelity-note",
      "text": "式(77.4a)中文和英文排版均把索引起点印成i=2，但本式及表77.2明显使用(H₁,q₁)并对q₁、q₂、q₃回归；规范索引校为i=1,2,…,n。"
    }
  ],
  "formulas": [
    {"label": "77.3a", "plain": "K_fs = T(q₂−q₁)/(H₂−H₁)", "latex": "K_{fs}=\\frac{T(q_2-q_1)}{H_2-H_1}", "resultUnit": "L·T⁻¹"},
    {"label": "77.3b", "plain": "α* = (q₂−q₁)/[q₁(H₂+T)−q₂(H₁+T)]", "latex": "\\alpha^*=\\frac{q_2-q_1}{q_1(H_2+T)-q_2(H_1+T)}", "resultUnit": "L⁻¹"},
    {"label": "77.3c", "plain": "T = C₁d + C₂a", "latex": "T=C_1d+C_2a", "resultUnit": "L"},
    {"label": "77.4a", "plain": "q_i = (K_fs/T)H_i + K_fs[1/(α*T)+1], i=1,2,…,n; n≥2", "latex": "q_i=\\frac{K_{fs}}{T}H_i+K_{fs}\\left(\\frac{1}{\\alpha^*T}+1\\right),\\quad i=1,2,\\ldots,n;\\ n\\ge2", "resultUnit": "L·T⁻¹"},
    {"label": "77.4b", "plain": "K_fs = T × slope", "latex": "K_{fs}=T\\times\\mathrm{slope}", "resultUnit": "L·T⁻¹"},
    {"label": "77.4c", "plain": "α* = K_fs/[T(intercept−K_fs)]", "latex": "\\alpha^*=\\frac{K_{fs}}{T(\\mathrm{intercept}-K_{fs})}", "resultUnit": "L⁻¹"}
  ],
