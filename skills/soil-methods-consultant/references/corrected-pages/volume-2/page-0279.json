      "latex": "\\operatorname{grad}(t_i)=\\frac{(\\psi_{1.5}+z_{1.5})-(\\psi_{4.5}+z_{4.5})}{z_{1.5}-z_{4.5}},\\quad i=1,2,3,\\ldots",
      "resultUnit": "L·L⁻¹"
    }
