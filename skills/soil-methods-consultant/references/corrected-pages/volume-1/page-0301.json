    {"scope": "30.6.2.1（5）", "label": "二次提取液体积比", "display": "DCM:MeOH = 1:1 (v/v)", "latex": "\\mathrm{DCM{:}MeOH}=1{:}1\\ (v/v)"},
    {"scope": "30.6.2.3（2）", "label": "转甲基酯化试剂体积比", "display": "MeOH:H₂SO₄ = 25:1 (v/v)", "latex": "\\mathrm{MeOH{:}H_2SO_4}=25{:}1\\ (v/v)"}
  ],
