    },
    "ollama": {
      "request_style": "ollama_chat",
      "transport": "rest_local",
      "relative_path": "/api/chat",
      "response_extractor": "ollama_chat",
      "structured_output_mode": "native_json_schema_plus_local_validation",
      "official_docs": [
        "https://docs.ollama.com/api/chat",
        "https://docs.ollama.com/capabilities/structured-outputs"
      ]
    },
    "custom": {
      "request_style": "user_contract_required",
      "transport": "user_documented",
      "relative_path": "user_contract_required",
      "response_extractor": "json_pointer_from_user_contract",
      "structured_output_mode": "user_documented_plus_local_validation",
      "official_docs": []
    }
  },
  "auth_policy": "Authentication secrets and credential headers must never be written to compiled request bundles, manifests, raw-response references, or receipts."
}
